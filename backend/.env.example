APP_ENV=development
HOST=127.0.0.1
PORT=8080
# Required in production or whenever HOST is not loopback. A trusted reverse
# proxy injects this header; never put it in frontend JavaScript.
API_AUTH_TOKEN=
# Must match sidecar/.env. Required in production.
SIDECAR_SHARED_SECRET=
DATABASE_URL=postgres://alphalens:alphalens@localhost:5432/alphalens?sslmode=disable
# Local development migrates automatically. Production uses the one-shot
# migration service in docker-compose.prod.yml.
RUN_DATABASE_MIGRATIONS=true
MIGRATE_ONLY=false
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
ENABLE_FREE_UNIVERSE=true
ENABLE_SEC_DATA=true
ENABLE_INSTITUTIONAL_DATA=true
SEC_USER_AGENT=CANSLIMAgent/1.0 your-email@example.com
ENABLE_STOOQ_DATA=true
ENABLE_YAHOO_FALLBACK=true
ENABLE_YFINANCE_FALLBACK=true
ENABLE_PROFILE_TRANSLATION=true
YFINANCE_PYTHON=python
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENT_REQUESTS=64
AI_ANALYSIS_TIMEOUT_SECONDS=1200
BROKER_SYNC_UPSTREAM_URL=http://127.0.0.1:8765
# Generate with: openssl rand -base64 32. Required before broker credentials can be saved.
BROKER_CREDENTIALS_ENCRYPTION_KEY=
# Optional separate key for LLM credentials. When empty, the broker key is
# reused with an independent AES-GCM scope.
LLM_CREDENTIALS_ENCRYPTION_KEY=

# OAuth configuration is server-only. Never put a client secret, access token,
# or private key in frontend/.env.
# Custom provider scopes are checked for read-only capabilities and rejected if
# they include order, trading, write, transfer, or other mutating actions.
# Longbridge uses a public PKCE client. Register it at its official OAuth
# endpoint and set only the returned client ID; the URLs, loopback callback,
# and documented scope=3 default automatically.
BROKER_LONGPORT_CLIENT_ID=
BROKER_LONGPORT_CLIENT_SECRET=
BROKER_LONGPORT_AUTHORIZE_URL=
BROKER_LONGPORT_TOKEN_URL=
BROKER_LONGPORT_ACCOUNT_URL=
BROKER_LONGPORT_REDIRECT_URL=
BROKER_LONGPORT_SCOPES=

# Tiger OpenAPI uses developer credentials rather than this browser OAuth flow.
# It is intentionally hidden in the product UI until its dedicated flow exists.
BROKER_TIGER_CLIENT_ID=
BROKER_TIGER_CLIENT_SECRET=
BROKER_TIGER_AUTHORIZE_URL=
BROKER_TIGER_TOKEN_URL=
BROKER_TIGER_ACCOUNT_URL=
# Register exactly: http://127.0.0.1:8080/api/v1/brokers/oauth/tiger/callback
BROKER_TIGER_REDIRECT_URL=
BROKER_TIGER_SCOPES=

# Local gateway discovery is loopback-only. Start and log in to OpenD or
# TWS/IB Gateway before using the corresponding connection card.
BROKER_FUTU_HOST=127.0.0.1
BROKER_FUTU_PORT=11111
BROKER_FUTU_ACCOUNT=
BROKER_IBKR_HOST=127.0.0.1
BROKER_IBKR_PORT=7497
BROKER_IBKR_CLIENT_ID=9901
BROKER_IBKR_ACCOUNT=
SCAN_DELAY_MS=80
