PORT=8080
DATABASE_URL=postgres://alphalens:alphalens@localhost:5432/alphalens?sslmode=disable
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
ENABLE_FREE_UNIVERSE=true
ENABLE_SEC_DATA=true
ENABLE_INSTITUTIONAL_DATA=true
SEC_USER_AGENT=CANSLIMAgent/1.0 your-email@example.com
ENABLE_STOOQ_DATA=true
ENABLE_YAHOO_FALLBACK=true
ENABLE_YFINANCE_FALLBACK=true
ENABLE_PROFILE_TRANSLATION=true
YFINANCE_PYTHON=python
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_TIMEOUT_SECONDS=20
AI_ANALYSIS_TIMEOUT_SECONDS=1200
BROKER_SYNC_UPSTREAM_URL=http://127.0.0.1:8765
# Generate with: openssl rand -base64 32. Required before broker credentials can be saved.
BROKER_CREDENTIALS_ENCRYPTION_KEY=

# OAuth developer applications are configured on the server only. Register the
# callback URLs shown below with each provider, then fill every required value.
# Never put a client secret, access token, or private key in frontend/.env.
# `*_SCOPES` is checked separately when OAuth starts: use a comma-separated
# list containing at least one explicit read-only scope; do not leave it empty
# or include order, trading, write, transfer, or other mutating scopes.
BROKER_LONGPORT_CLIENT_ID=
BROKER_LONGPORT_CLIENT_SECRET=
BROKER_LONGPORT_AUTHORIZE_URL=
BROKER_LONGPORT_TOKEN_URL=
BROKER_LONGPORT_ACCOUNT_URL=
# Register exactly: http://127.0.0.1:8080/api/v1/brokers/oauth/longport/callback
BROKER_LONGPORT_REDIRECT_URL=
BROKER_LONGPORT_SCOPES=

BROKER_TIGER_CLIENT_ID=
BROKER_TIGER_CLIENT_SECRET=
BROKER_TIGER_AUTHORIZE_URL=
BROKER_TIGER_TOKEN_URL=
BROKER_TIGER_ACCOUNT_URL=
# Register exactly: http://127.0.0.1:8080/api/v1/brokers/oauth/tiger/callback
BROKER_TIGER_REDIRECT_URL=
BROKER_TIGER_SCOPES=

# Local gateway discovery is loopback-only. Start and log in to OpenD or
# TWS/IB Gateway before using the corresponding connection card.
BROKER_FUTU_HOST=127.0.0.1
BROKER_FUTU_PORT=11111
BROKER_IBKR_HOST=127.0.0.1
BROKER_IBKR_PORT=7497
BROKER_IBKR_CLIENT_ID=9901
SCAN_DELAY_MS=80
