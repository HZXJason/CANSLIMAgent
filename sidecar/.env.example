# TradingAgents 数据 API
FINNHUB_API_KEY=your_finnhub_key_here

# LLM Provider Keys（按需填写）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
AI_GATEWAY_API_KEY=

# Sidecar 监听配置
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8765

# AI 流式输出节流
AI_REPORT_DELTA_CHARS=120
AI_REPORT_DELTA_DELAY=0.006
AI_NARRATION_INTERVAL_SECONDS=2.5

# Vibe-Trading 保持为隔离的 MCP / 回测运行时；未设置时兼容同级安装
# VIBE_TRADING_ROOT=/absolute/path/to/Vibe-Trading
ENABLE_VIBE_MCP_TOOLS=true

# 主分析流程：在 PM 建议后执行 Vibe 历史验证（默认 true；失败会显式标注为未验证）
ENABLE_VIBE_EXECUTION_VALIDATION=true
VIBE_EXECUTION_VALIDATION_TIMEOUT_SECONDS=90

# AI 分析断线续传 checkpoint（默认 sidecar/data/ai-runs）
# AI_ANALYSIS_CHECKPOINT_DIR=/absolute/path/to/ai-runs
