# TradingAgents 数据 API
FINNHUB_API_KEY=your_finnhub_key_here

# LLM Provider Keys（按需填写）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
AI_GATEWAY_API_KEY=

# Sidecar 监听配置
APP_ENV=development
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8765
# Must match backend/.env. Use at least 32 random characters in production.
SIDECAR_SHARED_SECRET=
SIDECAR_MAX_REQUEST_BODY_BYTES=4194304
SIDECAR_MAX_CONCURRENT_REQUESTS=16

# Browser requests cannot supply LLM keys or arbitrary model endpoints. Add
# trusted custom HTTPS gateways here on the server only.
AI_ALLOWED_BACKEND_HOSTS=ai-gateway.vercel.sh
# Production always requires the allowlist. Development accepts other public
# HTTPS hosts unless this stricter switch is enabled.
AI_REQUIRE_BACKEND_ALLOWLIST=false
AI_ALLOW_PRIVATE_BACKENDS=false
AI_MAX_ACTIVE_RUNS=4
AI_MAX_EVENTS_PER_RUN=10000
AI_MAX_BUFFERED_BYTES_PER_RUN=16777216
AI_CHECKPOINT_RETENTION_HOURS=24

# 历史校准默认同时运行 7 个节点；可按网关限额调整为 1-10。
AI_CALIBRATION_CONCURRENCY=7
AI_CALIBRATION_NODE_MAX_ATTEMPTS=3
# 已完成节点与未完成节点的 checkpoint 索引，支持失败后只补缺失节点。
# AI_CALIBRATION_NODE_CACHE_DIR=/absolute/path/to/calibration-nodes

# AI 流式输出节流
AI_REPORT_DELTA_CHARS=120
AI_REPORT_DELTA_DELAY=0.006
AI_NARRATION_INTERVAL_SECONDS=2.5

# Vibe-Trading 保持为隔离的 MCP / 交易日志复盘运行时；未设置时兼容同级安装
# VIBE_TRADING_ROOT=/absolute/path/to/Vibe-Trading
ENABLE_VIBE_MCP_TOOLS=true

# AI 分析断线续传 checkpoint（默认 sidecar/data/ai-runs）
# AI_ANALYSIS_CHECKPOINT_DIR=/absolute/path/to/ai-runs

# 确定性量化趋势快照与历史评估 Run Card（默认 sidecar/data/quant-trend）
# QUANT_TREND_ARTIFACT_DIR=/absolute/path/to/quant-trend
# QUANT_TREND_PRICE_CACHE_DIR=/absolute/path/to/quant-trend/prices
